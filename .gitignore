# Unity project lives in BirdLifeSimulator, relative to this repository root.
# Keep Assets (including .meta files), Packages, and ProjectSettings in Git.

# Unity caches and local editor state
/BirdLifeSimulator/[Ll]ibrary/
/BirdLifeSimulator/[Tt]emp/
/BirdLifeSimulator/[Ll]ogs/
/BirdLifeSimulator/[Oo]bj/
/BirdLifeSimulator/[Uu]ser[Ss]ettings/
/BirdLifeSimulator/[Mm]emoryCaptures/
/BirdLifeSimulator/[Rr]ecordings/
/BirdLifeSimulator/UIElementsSchema/
# Android GameActivity CMake intermediates generated by builds
/BirdLifeSimulator/.utmp/

# Build output (also cover builds placed at the repository root)
/[Bb]uild/
/[Bb]uilds/
/BirdLifeSimulator/[Bb]uild/
/BirdLifeSimulator/[Bb]uilds/
/BirdLifeSimulator/ServerData/
/BirdLifeSimulator/*.apk
/BirdLifeSimulator/*.aab
/BirdLifeSimulator/*.unitypackage
/BirdLifeSimulator/*.app

# IDE caches and generated configuration
.vs/
.idea/
.gradle/
.consulo/
ExportedObj/
/BirdLifeSimulator/.vscode/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.user
*.userprefs
*.DotSettings.user
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.tmp

# Unity crash and diagnostic output at the project root
/BirdLifeSimulator/*.log
/BirdLifeSimulator/sysinfo.txt
/BirdLifeSimulator/mono_crash.*
/BirdLifeSimulator/crashlytics-build.properties

# Source assets and their metadata must remain eligible for tracking.
# Override broad extension rules above for files inside these directories.
!/BirdLifeSimulator/Assets/**
!/BirdLifeSimulator/Packages/**
!/BirdLifeSimulator/ProjectSettings/**
